	column CSA_Number =
			
			VALUE(LEFT(Equity[AREA_ID], SEARCH(".", Equity[AREA_ID]) - 1))
		lineageTag: cb4baa76-7ea4-4f5c-8660-877bd0a45561
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Quadrant =
			
			MID(Equity[AREA_ID], SEARCH(".", Equity[AREA_ID]) + 1, 2)
		lineageTag: 25e2b94b-1728-4e24-b02e-99ed53ef8c45
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Income_Tertile_Num =
			
			VAR r = RANKX(ALL(Equity), Equity[Median Income], , ASC)
			VAR n = COUNTROWS(ALL(Equity))
			RETURN ROUNDUP(r / n * 3, 0)
		lineageTag: f8458580-75f3-4228-bd7e-b2b248cfd0e8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Income_Tertile = SWITCH(Equity[Income_Tertile_Num], 1, "Low", 2, "Mid", 3, "High")
		lineageTag: 27cf43b4-9715-41ec-8ae1-118a7c1cb19e
		summarizeBy: none
		sortByColumn: Income_Tertile_Num

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Income_Quintile =
			
			VAR r = RANKX(ALL(Equity), Equity[Median Income], , ASC)
			VAR n = COUNTROWS(ALL(Equity))
			VAR q = ROUNDUP(r / n * 5, 0)
			RETURN "Q" & q & SWITCH(q, 1, " lowest", 5, " highest", "")
		lineageTag: 58075db8-3569-46d5-befe-d90d0ee05f86
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Local_Incidents = COUNTROWS(FILTER(Incidents, Incidents[AREA_ID] = Equity[AREA_ID] && Incidents[Road_Class] = "Local / arterial" && Incidents[Year] >= 2017 && Incidents[Year] <= 2025))
		formatString: 0
		lineageTag: 91cbda0a-4ef3-40c6-8e90-1a81c51d173b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Local_Rate = DIVIDE(Equity[Local_Incidents], Equity[Population] * 9) * 1000
		lineageTag: b48290cf-e351-43f2-8083-d7e6b4a564ec
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Rate_Tertile_Num = ROUNDUP(RANKX(ALL(Equity), Equity[Local_Rate], , ASC) / COUNTROWS(ALL(Equity)) * 3, 0)
		lineageTag: 4951c7c4-2efc-41c0-bb92-4199d914e0dd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Bivariate_Class = Equity[Income_Tertile_Num] & "-" & Equity[Rate_Tertile_Num]
		lineageTag: d59af268-25a5-44e1-8d52-28febe681586
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Equity = m
		mode: import
		source =
				let
				      Source = Csv.Document(File.Contents(DataFolder & "Calgary_Equity_Index_Overlay_Statistics.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {
				    {"AREA_ID", type text},
				    {"Population", Int64.Type},
				    {"Median Income", Currency.Type},
				    {"Children", Percentage.Type},
				    {"Drive to work", Percentage.Type},
				    {"Indigenous", Percentage.Type},
				    {"LIM-AT 0-17 years", Percentage.Type},
				    {"LIM-AT 18-64 years", Percentage.Type},
				    {"LIM-AT 65+ years", Percentage.Type},
				    {"Live in single detached home", Percentage.Type},
				    {"Lone Parent", Percentage.Type},
				    {"Moved in the last year", Percentage.Type},
				    {"Newcomers", Percentage.Type},
				    {"No English Knowledge", Percentage.Type},
				    {"Renter", Percentage.Type},
				    {"Seniors", Percentage.Type},
				    {"Transit to work", Percentage.Type},
				    {"Visible Minority", Percentage.Type},
				    {"Youth", Percentage.Type},
				    {"Area_km2", type number},
				    {"WKT", type text}
				}, "en-US")
				in
				  #"Changed column type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

