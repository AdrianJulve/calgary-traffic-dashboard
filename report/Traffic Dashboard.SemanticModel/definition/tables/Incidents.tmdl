table Incidents
	lineageTag: 96406425-5ae6-487d-88f8-7acbd99711ca

	measure 'Incident Count' = COUNTROWS(Incidents)
		formatString: 0
		lineageTag: 3443695a-cf21-4919-ad51-42e25b5959e9

	measure 'Years in Scope' = CALCULATE(DISTINCTCOUNT(Incidents[Year]), REMOVEFILTERS(Equity), REMOVEFILTERS(Communities))
		formatString: 0
		lineageTag: f477c123-a380-4f31-a5f8-baba38e568c9

	measure 'Rate per 1k' = DIVIDE([Incident Count], SUM(Equity[Population]) * [Years in Scope]) * 1000
		lineageTag: 2b6c1dc3-bc01-4146-8b4c-cddabcc311c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rate Rank' = RANKX(ALL(Equity[AREA_ID]), [Rate per 1k], , DESC)
		formatString: 0
		lineageTag: 46d80259-c3f9-4252-b5ee-60a06c4483d6

	measure 'Incidents per km2' = DIVIDE([Incident Count], SUM(Communities[Area_km2]) * [Years in Scope])
		lineageTag: 5348b643-51c1-4088-802e-e2307704f515

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Income Gap' =
			
			DIVIDE(
			    CALCULATE([Rate per 1k], Equity[Income_Tertile] = "Low"),
			    CALCULATE([Rate per 1k], Equity[Income_Tertile] = "High")
			)
		lineageTag: 004e8c6e-385b-4980-8930-db95cf779c60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Hour' =
			
			VAR t = ADDCOLUMNS(VALUES(Incidents[Hour]), "@n", [Incident Count])
			VAR h = MAXX(TOPN(1, t, [@n], DESC), Incidents[Hour])
			RETURN FORMAT(TIME(h, 0, 0), "h AM/PM") & "–" & FORMAT(TIME(MOD(h + 1, 24), 0, 0), "h AM/PM")
		lineageTag: cfb419bb-62a1-4e0e-a20e-6c7e8cc702dd

	measure 'Rate vs City Avg' =
			
			VAR _sel  = [Rate per 1k]
			VAR _city = CALCULATE([Rate per 1k], REMOVEFILTERS(Equity), REMOVEFILTERS(Bivariate_Legend))
			RETURN COALESCE(DIVIDE(_sel, _city), 0)
		lineageTag: d6964ea8-6939-460c-8d2b-026d78c23cbd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Heatmap Tip' =
			
			SELECTEDVALUE(Incidents[Weekday]) & " · " & SELECTEDVALUE(Incidents[Hour_Label]) &
			": " & FORMAT([Incident Count], "#,0") & " incidents"
		lineageTag: d2865018-7cdf-44b6-a565-3216a2bfe749

	measure 'Days with Data' =
			
			CALCULATE(DISTINCTCOUNT(Incidents[Date]),
			    ALLEXCEPT(Incidents, Incidents[Year], Incidents[Month], Incidents[Month_Name], Incidents[Date]))
		formatString: 0
		lineageTag: 82552097-c124-418b-9e76-dce9aa157b47

	measure 'Monthly Rate per 100k' =
			
			VAR d = [Days with Data]
			RETURN IF(d < 15, BLANK(), DIVIDE([Incident Count] / d * 30.44, SUM(Equity[Population])) * 100000)
		lineageTag: 04a1c874-e196-4ec5-a203-a4b640126b04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Month Bar Color' =
			
			VAR _v   = [Monthly Rate per 100k]
			VAR _avg = AVERAGEX(ALLSELECTED(Incidents[Month_Name], Incidents[Month]), [Monthly Rate per 100k])
			RETURN IF(_v > _avg, "#D47BA3", "#6C83B5")
		lineageTag: 8a9ad533-1e23-4070-988e-45dcdf8fdfbd

	measure 'Txt Years' =
			
			VAR _lo = CALCULATE(MIN(Incidents[Year]), REMOVEFILTERS(Equity), REMOVEFILTERS(Bivariate_Legend))
			VAR _hi = CALCULATE(MAX(Incidents[Year]), REMOVEFILTERS(Equity), REMOVEFILTERS(Bivariate_Legend))
			RETURN IF(_lo = _hi, FORMAT(_lo, "0"), _lo & "–" & _hi)
		lineageTag: a2a363c8-1e63-4f1c-b10b-448fa8ad8e78

	measure 'Txt Types' =
			
			IF(ISFILTERED(Incidents[Incident_Type]),
			    LOWER(CONCATENATEX(VALUES(Incidents[Incident_Type]), Incidents[Incident_Type], ", ")) & " incidents",
			    "all incident types")
		lineageTag: a40ebe76-24e0-44d3-a30a-d71a554d1cd6

	measure 'Txt Community' =
			
			IF(ISFILTERED(Communities[CLASS]),
			    LOWER(CONCATENATEX(VALUES(Communities[CLASS]), Communities[CLASS], ", ")) & " communities",
			    "all community types")
		lineageTag: be137a97-c539-46fd-a36d-07408412ea1c

	measure 'Txt Scope' =
			
			VAR _n   = COUNTROWS(VALUES(Equity[AREA_ID]))
			  VAR _all = COUNTROWS(ALLNOBLANKROW(Equity))
			RETURN SWITCH(TRUE(),
			    _n = 1, "CSA " & SELECTEDVALUE(Equity[AREA_ID]),
			    _n < _all, _n & " selected areas",
			    "all of Calgary")
		lineageTag: 77a38119-92cf-4e64-b32a-4c80ba84180e

	column id
		dataType: string
		lineageTag: c712fb44-8ecf-4426-8346-6eefd151491a
		summarizeBy: none
		sourceColumn: id

		annotation SummarizationSetBy = Automatic

	column Location
		dataType: string
