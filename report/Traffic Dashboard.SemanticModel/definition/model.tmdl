model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Incidents","Equity","Communities","DataFolder"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table Incidents
ref table Equity
ref table Communities
ref table Bivariate_Legend

ref cultureInfo en-US

